<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <!-- WebDAV بيحجز PUT و DELETE ويرجّع 405 Method Not Allowed قبل ما يوصل الطلب للتطبيق -->
      <remove name="WebDAV" />
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>

    <modules runAllManagedModulesForAllRequests="false">
      <remove name="WebDAVModule" />
    </modules>

    <!-- القيم هون بيستبدلها النشر تلقائياً بالمسار الصحيح للتطبيق -->
    <aspNetCore processPath="%LAUNCHER_PATH%" arguments="%LAUNCHER_ARGS%" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
      <environmentVariables>
        <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
      </environmentVariables>
    </aspNetCore>

    <security>
      <requestFiltering>
        <!-- السماح الصريح بأفعال التعديل (تعديل/حذف) وبطلب الـ preflight الخاص بـ CORS -->
        <verbs allowUnlisted="true">
          <remove verb="PUT" />
          <add verb="PUT" allowed="true" />
          <remove verb="DELETE" />
          <add verb="DELETE" allowed="true" />
          <remove verb="PATCH" />
          <add verb="PATCH" allowed="true" />
          <remove verb="OPTIONS" />
          <add verb="OPTIONS" allowed="true" />
        </verbs>
        <!-- 50 ميغا: يكفي لملفات الإكسل المستوردة -->
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <!-- IIS بيضيف هالترويسة لحاله وبتتعارض مع ترويسات CORS الصادرة من التطبيق -->
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
