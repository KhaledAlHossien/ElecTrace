@using Blazored.LocalStorage
@inherits LayoutComponentBase

@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider
@inject ILocalStorageService LocalStorage

<div class="page" dir="rtl">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <div>
                <span class="top-row-title">نظام فواتير الكهرباء</span>
                <span class="top-row-subtitle">متابعة العدادات والاستهلاك والتقارير</span>
            </div>
            <AuthorizeView>
                <Authorized>
                    <div class="user-chip">
                        <span>@displayName</span>
                        <button class="btn btn-outline-danger btn-sm" @onclick="Logout">خروج</button>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private string displayName = "مستخدم";

    protected override async Task OnInitializedAsync()
    {
        displayName = await LocalStorage.GetItemAsync<string>("fullName")
            ?? await LocalStorage.GetItemAsync<string>("userName")
            ?? "مستخدم";
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        var customProvider = AuthProvider as CustomAuthStateProvider;
        customProvider?.NotifyUserLogout();
        Navigation.NavigateTo("/login", true);
    }
}
