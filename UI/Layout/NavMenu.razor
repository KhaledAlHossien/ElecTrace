<div class="top-row ps-3 navbar">
    <div class="container-fluid">
        <a class="navbar-brand" href="">ElecTrace</a>
        <button title="فتح القائمة" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <NavItem Href="" Match="NavLinkMatch.All" Icon="bi-house-door-fill-nav-menu" Text="الرئيسية" />
        <NavItem Href="departments" Icon="bi-building-nav-menu" Text="الأقسام والعدادات" />
        <NavItem Href="readings" Icon="bi-speedometer-nav-menu" Text="قراءات الكهرباء" />
        <NavItem Href="users" Icon="bi-people-nav-menu" Text="المستخدمون" />
        <NavItem Href="roles" Icon="bi-people-nav-menu" Text="الأدوار" />
        <NavItem Href="reports" Icon="bi-file-nav-menu" Text="التقارير" />
        <NavItem Href="settings" Icon="bi-gear-nav-menu" Text="الإعدادات" />
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
