@page "/readings"
@attribute [Authorize]
@inject IApiDataService Api
@inject IJSRuntime Js

<PageTitle>قراءات الكهرباء</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">الاستهلاك الشهري</p>
        <h1>قراءات الكهرباء</h1>
        <p>سجل القراءة لكل قسم، واستعرض الاستهلاك والتكلفة المحسوبة حسب الشهر والسنة.</p>
    </div>
</section>

<div class="row">
    <div class="col-md-3">
        <div class="panel">
            <div class="panel-header">
                <div>
                    <h2>إدخال قراءة</h2>
                    <p>ابحث باسم القسم أو رمز العداد ثم اختر النتيجة.</p>
                </div>
            </div>

            <EditForm Model="@form" OnValidSubmit="SaveReading">
                <DataAnnotationsValidator />
                <div class="form-stack">
                    <div>
                        <label class="form-label">القسم أو العداد</label>
                        <div style="position: relative;">
                            <input type="text" class="form-control"
                                   placeholder="اكتب اسم القسم أو رمز العداد..."
                                   value="@form.MeterCode"
                                   @oninput="FilterDepartments"
                                   @onfocus="ShowDropdown"
                                   @onblur="HideDropdown"
                                   autocomplete="off" />

                            @if (showDropdown && departmentResults.Any())
                            {
                                <div class="list-group shadow mt-1" style="position: absolute; z-index: 1000; width: 100%; max-height: 250px; overflow-y: auto; background-color: white;">
                                    @foreach (var department in departmentResults)
                                    {
                                        <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                                @onmousedown="() => SelectDepartment(department)"
                                                @onmousedown:preventDefault>
                                            <strong>@department.Name</strong>
                                            <span class="badge bg-primary rounded-pill">@department.MeterCode</span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                    <div>
                        <label class="form-label">الشهر</label>
                        <InputSelect class="form-select" @bind-Value="form.Month">
                            @foreach (var month in Enum.GetValues<Months>())
                            {
                                <option value="@month">@MonthName(month)</option>
                            }
                        </InputSelect>
                    </div>
                    <div>
                        <label class="form-label">القراءة</label>
                        <InputNumber class="form-control" @bind-Value="form.CurrentReading" />
                    </div>
                    @if (!string.IsNullOrWhiteSpace(message))
                    {
                        <div class="alert @messageCss mt-2">@message</div>
                    }
                    <button class="btn btn-primary w-100 mt-3" type="submit" disabled="@isSaving">تسجيل القراءة</button>
                </div>
            </EditForm>
        </div>
    </div>

    <div class="col-md-9">
        <div class="panel wide-panel">
            <div class="panel-header filter-header">
                <div>
                    <h2>قراءات الشهر</h2>
                    <p>@readings.Count قراءة ظاهرة.</p>
                </div>
                <div class="filters">
                    <button class="btn btn-outline-success"
                            @onclick="ExportElectricityReport"
                            disabled="@isLoading">
                        تقرير الاستهلاك
                    </button>
                    <label class="btn btn-outline-primary"
                           for="fileInputOld"
                           title="
                        A:رقم تسلسلي
                        B:اسم القسم
                        C: القراءة السابقة
                        D: القراءة الحالية
                        E:الاستهلاك
                        F:فارغ
                        G:سعر الكيلو واط
                        H:القيمة النهائية
                        I:رمز العداد
                        ">
                        استيراد إكسل
                    </label>
                    <InputFile id="fileInputOld" OnChange="HandleFileSelected" hidden />

                    <label class="btn btn-outline-primary"
                           for="fileInputCurrent"
                           title="
                        A:رقم تسلسلي
                        B:رمز العداد
                        C: القراءة الحالية
                        ">
                        استيراد قراءات حالية
                    </label>
                    <InputFile id="fileInputCurrent" OnChange="ImportCurrentReadings" hidden />

                    <select class="form-select" value="@selectedMonth" @onchange="OnMonthChanged">
                        @foreach (var month in Enum.GetValues<Months>())
                        {
                            <option value="@month">@MonthName(month)</option>
                        }
                    </select>
                    <input class="form-control year-input" type="number" value="@selectedYear" @onchange="OnYearChanged" />
                </div>
            </div>

            @if (isLoading)
            {
                <div class="loading-panel">جاري تحميل القراءات...</div>
            }
            else if (!readings.Any())
            {
                <EmptyState Text="لا توجد قراءات لهذا الشهر." />
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>القسم</th>
                                <th>الشهر</th>
                                <th>السابقة</th>
                                <th>الحالية</th>
                                <th>الاستهلاك</th>
                                <th>السعر الإجمالي</th>
                                <th>تم الإدخال بواسطة</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var reading in readings)
                            {
                                <tr>
                                    <td><strong>@reading.DepartmentName</strong></td>
                                    <td>@MonthName(reading.Month)</td>
                                    <td>@reading.PreviousReading.ToString("N0")</td>
                                    <td>@reading.CurrentReading.ToString("N0")</td>
                                    <td><span class="status-pill">@reading.ActualConsumption.ToString("N0") ك.و.س</span></td>
                                    <td><strong>@reading.TotalCost.ToString("N0") ل.س</strong></td>
                                    <td>
                                        <span class="badge bg-light text-dark">
                                            @(string.IsNullOrEmpty(reading.CreatedByUserName) ? "excel import" : reading.CreatedByUserName)
                                        </span>
                                    </td>
                                    <td class="table-actions">
                                        <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteReading(reading.Id)">حذف</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    // جلبنا فكرة البحث المحلي من صفحة الأقسام لضمان السرعة
    private List<DepartmentResponseDto> allActiveDepartments = [];
    private List<DepartmentResponseDto> departmentResults = [];

    private List<MeterReadingResponseDto> readings = [];
    private ReadingForm form = new();
    private Months selectedMonth = (Months)DateTime.Today.Month;
    private int selectedYear = DateTime.Today.Year;
    private bool isLoading = true;
    private bool isSaving;
    private bool showDropdown = false;
    private string message = "";
    private string messageCss = "alert-success";

    protected override async Task OnInitializedAsync()
    {
        form.Month = selectedMonth;

        // جلب الأقسام مرة واحدة عند التحميل (نفس طريقتك بـ departments.razor)
        var deps = await Api.GetDepartmentsAsync();
        allActiveDepartments = deps.Where(d => d.IsActive && !d.IsFixed).ToList();

        await LoadReadings();
    }

    private void FilterDepartments(ChangeEventArgs e)
    {
        form.MeterCode = e.Value?.ToString() ?? "";
        UpdateSearch();
    }

    private void ShowDropdown()
    {
        UpdateSearch();
    }

    private async Task HideDropdown()
    {
        // تأخير بسيط جداً للسماح بحدث الضغط على القائمة بالتنفيذ قبل إخفائها
        await Task.Delay(150);
        showDropdown = false;
        StateHasChanged();
    }

    private void UpdateSearch()
    {
        if (string.IsNullOrWhiteSpace(form.MeterCode))
        {
            // عرض أول 5 نتائج افتراضياً
            departmentResults = allActiveDepartments.Take(5).ToList();
        }
        else
        {
            // فلترة محلية سريعة جداً بدون API
            departmentResults = allActiveDepartments
                .Where(d => d.Name.Contains(form.MeterCode, StringComparison.OrdinalIgnoreCase) ||
                            d.MeterCode.Contains(form.MeterCode, StringComparison.OrdinalIgnoreCase))
                .Take(5).ToList();
        }

        showDropdown = departmentResults.Any();
    }

    private void SelectDepartment(DepartmentResponseDto department)
    {
        form.MeterCode = department.MeterCode;
        showDropdown = false;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        isLoading = true;
        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024 * 5);
            await Api.ImportMeterReadingsAsync(stream, selectedMonth, selectedYear);
            ShowSuccess("تم استيراد البيانات بنجاح.");
            await LoadReadings();
        }
        catch (Exception ex)
        {
            ShowError("فشل الاستيراد: " + ex.Message);
        }
        finally { isLoading = false; }
    }

    private async Task ImportCurrentReadings(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        isLoading = true;
        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024 * 5);
            await Api.ImportCurrentReadingsAsync(stream, selectedMonth, selectedYear);
            ShowSuccess("تم استيراد البيانات بنجاح.");
            await LoadReadings();
        }
        catch (Exception ex)
        {
            ShowError("فشل الاستيراد: " + ex.Message);
        }
        finally { isLoading = false; }
    }

    private async Task OnMonthChanged(ChangeEventArgs args)
    {
        if (Enum.TryParse<Months>(args.Value?.ToString(), out var month))
        {
            selectedMonth = month;
            form.Month = month;
            await LoadReadings();
        }
    }

    private async Task OnYearChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var year))
        {
            selectedYear = year;
            await LoadReadings();
        }
    }

    private async Task LoadReadings()
    {
        isLoading = true;
        readings = (await Api.GetMeterReadingsAsync(selectedMonth, selectedYear)).ToList();
        isLoading = false;
    }

    private async Task SaveReading()
    {
        if (string.IsNullOrWhiteSpace(form.MeterCode))
        {
            ShowError("الرجاء كتابة أو اختيار رمز العداد.");
            return;
        }
        isSaving = true;
        try
        {
            await Api.CreateMeterReadingAsync(new CreateMeterReadingRequestDto(form.MeterCode, form.Month, form.CurrentReading));
            ShowSuccess("تم تسجيل القراءة.");
            selectedMonth = form.Month;

            form.CurrentReading = 0;
            form.MeterCode = string.Empty;
            showDropdown = false;

            await LoadReadings();
        }
        catch (Exception ex) { ShowError(ex.Message); }
        finally { isSaving = false; }
    }

    private async Task DeleteReading(int id)
    {
        try
        {
            await Api.DeleteMeterReadingAsync(id);
            ShowSuccess("تم حذف القراءة.");
            await LoadReadings();
        }
        catch (Exception ex) { ShowError(ex.Message); }
    }

    private void ShowSuccess(string text) { message = text; messageCss = "alert-success"; }
    private void ShowError(string text) { message = text; messageCss = "alert-danger"; }

    private static string MonthName(Months month) => month switch
    {
        Months.January => "كانون الثاني",
        Months.February => "شباط",
        Months.March => "آذار",
        Months.April => "نيسان",
        Months.May => "آيار",
        Months.June => "حزيران",
        Months.July => "تموز",
        Months.August => "آب",
        Months.September => "أيلول",
        Months.October => "تشرين الأول",
        Months.November => "تشرين الثاني",
        Months.December => "كانون الأول",
        _ => month.ToString()
    };

    private sealed class ReadingForm
    {
        public string MeterCode { get; set; } = string.Empty;
        public Months Month { get; set; }
        public decimal CurrentReading { get; set; }
    }

    private async Task ExportElectricityReport()
    {
        try
        {
            var result = await Api.DownloadElectricityReportAsync(selectedMonth, selectedYear);

            if (!result.IsSuccess)
            {
                ShowError(result.ErrorMessage ?? "لا يوجد تقرير لهذا الشهر.");
                return;
            }

            var base64 = Convert.ToBase64String(result.Content!);
            await Js.InvokeVoidAsync("downloadFileFromBytes", result.FileName, result.ContentType, base64);

            ShowSuccess("تم تنزيل تقرير الاستهلاك بنجاح.");
        }
        catch (Exception ex)
        {
            ShowError("فشل تنزيل التقرير: " + ex.Message);
        }
    }
}