@page "/readings"
@attribute [Authorize]
@inject IApiDataService Api
@inject IJSRuntime Js
@inject ToastService Toasts
@inject DialogService Dialog

<PageTitle>قراءات الكهرباء</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow"><Icon Name="zap" Size="13" /> الاستهلاك الشهري</p>
        <h1>قراءات الكهرباء</h1>
        <p>سجل القراءة لكل قسم، واستعرض الاستهلاك والتكلفة المحسوبة حسب الشهر والسنة.</p>
    </div>
    <button class="btn btn-primary" @onclick="OpenCreate">
        <Icon Name="plus" Size="17" />
        <span>تسجيل قراءة</span>
    </button>
</section>

<section class="panel">
    <div class="panel-header filter-header">
        <div>
            <h2>قراءات الشهر</h2>
            <p>@readings.Count قراءة — @MonthName(selectedMonth) @selectedYear</p>
        </div>
        <div class="filters">
            <select class="form-select" value="@selectedMonth" @onchange="OnMonthChanged">
                @foreach (var month in Enum.GetValues<Months>())
                {
                    <option value="@month">@MonthName(month)</option>
                }
            </select>
            <input class="form-control year-input" type="number" value="@selectedYear" @onchange="OnYearChanged" />

            <label class="btn btn-light" for="fileInputOld"
                   title="A: رقم تسلسلي — B: اسم القسم — C: القراءة السابقة — D: القراءة الحالية — E: الاستهلاك — G: سعر الكيلو واط — H: القيمة النهائية — I: رمز العداد">
                <Icon Name="upload" Size="16" />
                <span>استيراد إكسل</span>
            </label>
            <InputFile id="fileInputOld" OnChange="HandleFileSelected" hidden />

            <label class="btn btn-light" for="fileInputCurrent" title="A: رقم تسلسلي — B: رمز العداد — C: القراءة الحالية">
                <Icon Name="upload" Size="16" />
                <span>استيراد قراءات حالية</span>
            </label>
            <InputFile id="fileInputCurrent" OnChange="ImportCurrentReadings" hidden />

            <button class="btn btn-light" @onclick="ExportElectricityReport" disabled="@(isLoading || isExporting)">
                @if (isExporting)
                {
                    <span class="spinner"></span>
                }
                else
                {
                    <Icon Name="download" Size="16" />
                }
                <span>تقرير الاستهلاك</span>
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <TableSkeleton Rows="8" Columns="7" />
    }
    else if (!readings.Any())
    {
        <EmptyState Title="لا توجد قراءات" Text="لا توجد قراءات مسجلة لهذا الشهر." IconName="gauge">
            <button class="btn btn-primary btn-sm" @onclick="OpenCreate">
                <Icon Name="plus" Size="15" />
                <span>تسجيل قراءة</span>
            </button>
        </EmptyState>
    }
    else
    {
        var visible = FilteredReadings.ToList();

        <div class="table-toolbar">
            <div class="search-wrap">
                <span class="search-icon"><Icon Name="search" Size="16" /></span>
                <input class="form-control" placeholder="ابحث باسم القسم أو رمز العداد أو المستخدم..."
                       @bind="searchText" @bind:event="oninput" @onkeydown="OnSearchKeyDown" />
                @if (!string.IsNullOrEmpty(searchText))
                {
                    <button type="button" class="search-clear" title="مسح البحث (Esc)" @onclick="ClearSearch">
                        <Icon Name="x" Size="13" />
                    </button>
                }
            </div>
            <span class="table-count">
                @if (IsSearching)
                {
                    <strong>@visible.Count</strong>
                    <span>من أصل @readings.Count</span>
                }
                else
                {
                    <span>@readings.Count قراءة</span>
                }
            </span>
        </div>

        @if (!visible.Any())
        {
            <EmptyState Title="لا توجد نتائج" Text="لا توجد قراءات تطابق بحثك." IconName="search">
                <button class="btn btn-light btn-sm" @onclick="ClearSearch">
                    <Icon Name="x" Size="14" />
                    <span>مسح البحث</span>
                </button>
            </EmptyState>
        }
        else
        {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>القسم</th>
                        <th>الشهر</th>
                        <th>السابقة</th>
                        <th>الحالية</th>
                        <th>الاستهلاك</th>
                        <th>السعر الإجمالي</th>
                        <th>أُدخلت بواسطة</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var index = 0;
                    }
                    @foreach (var reading in visible)
                    {
                        <tr class="@(reading.CurrentReading < reading.PreviousReading ? "row-warning" : "")"
                            style="--i:@(index++ % 25)" @key="reading.Id">
                            <td><strong>@reading.DepartmentName</strong></td>
                            <td>@MonthName(reading.Month)</td>
                            <td>@reading.PreviousReading.ToString("N0")</td>
                            <td>@reading.CurrentReading.ToString("N0")</td>
                            <td><span class="status-pill">@reading.ActualConsumption.ToString("N0") ك.و.س</span></td>
                            <td><strong>@reading.TotalCost.ToString("N0") ل.س</strong></td>
                            <td>
                                <span class="status-pill neutral">
                                    @(string.IsNullOrEmpty(reading.CreatedByUserName) ? "excel import" : reading.CreatedByUserName)
                                </span>
                            </td>
                            <td>
                                <div class="table-actions">
                                    <button class="btn btn-outline-danger" title="حذف" @onclick="() => DeleteReading(reading)">
                                        <Icon Name="trash" Size="15" />
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        }
    }
</section>

<Modal IsOpen="@isFormOpen" OnClose="CloseForm" Size="sm"
       Title="تسجيل قراءة جديدة"
       Subtitle="ابحث باسم القسم أو رمز العداد ثم اختر النتيجة."
       IconName="zap">
    <EditForm Model="@form" OnValidSubmit="SaveReading">
        <DataAnnotationsValidator />
        <div class="form-stack">
            <div>
                <label class="form-label">القسم أو العداد</label>
                <div class="input-icon-wrap" style="position:relative;">
                    <span class="input-icon"><Icon Name="search" Size="17" /></span>
                    <input type="text" class="form-control"
                           placeholder="اكتب اسم القسم أو رمز العداد..."
                           value="@form.MeterCode"
                           @oninput="FilterDepartments"
                           @onfocus="ShowDropdown"
                           @onblur="HideDropdown"
                           autocomplete="off" />

                    @if (showDropdown && departmentResults.Any())
                    {
                        <div class="suggest-list">
                            @foreach (var department in departmentResults)
                            {
                                <button type="button" class="suggest-item"
                                        @onmousedown="() => SelectDepartment(department)"
                                        @onmousedown:preventDefault>
                                    <strong>@department.Name</strong>
                                    <span class="status-pill neutral">@department.MeterCode</span>
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="form-row">
                <div>
                    <label class="form-label">الشهر</label>
                    <InputSelect class="form-select" @bind-Value="form.Month">
                        @foreach (var month in Enum.GetValues<Months>())
                        {
                            <option value="@month">@MonthName(month)</option>
                        }
                    </InputSelect>
                </div>
                <div>
                    <label class="form-label">القراءة الحالية</label>
                    <div class="input-icon-wrap">
                        <span class="input-icon"><Icon Name="gauge" Size="17" /></span>
                        <InputNumber class="form-control" @bind-Value="form.CurrentReading" />
                    </div>
                </div>
            </div>

            <div class="button-row">
                <button class="btn btn-primary" type="submit" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner"></span>
                    }
                    else
                    {
                        <Icon Name="check" Size="17" />
                    }
                    <span>تسجيل القراءة</span>
                </button>
                <button class="btn btn-light" type="button" @onclick="CloseForm">إلغاء</button>
            </div>
        </div>
    </EditForm>
</Modal>

@code {
    // بحث محلي بالأقسام لضمان السرعة بدون استدعاء الـ API كل حرف
    private List<DepartmentResponseDto> allActiveDepartments = [];
    private List<DepartmentResponseDto> departmentResults = [];

    private List<MeterReadingResponseDto> readings = [];

    // فهرس بحث جاهز لكل قراءة (اسم القسم + رمز العداد + المستخدم) بعد توحيد النص العربي،
    // فبكل ضغطة مفتاح منقارن بس مع نص جاهز بدل ما نعيد المعالجة
    private Dictionary<int, string> searchIndex = new();
    private Dictionary<int, string> meterCodes = new();
    private string searchText = "";

    private bool IsSearching => !string.IsNullOrWhiteSpace(searchText);

    // كل كلمة بالبحث لازم تنطبق (AND): "مطعم شام" بيلاقي "مطعم الشام"
    private IEnumerable<MeterReadingResponseDto> FilteredReadings
    {
        get
        {
            var tokens = SearchNormalizer.Tokens(searchText);
            if (tokens.Length == 0)
                return readings;

            return readings.Where(r =>
                searchIndex.TryGetValue(r.Id, out var haystack) &&
                tokens.All(token => haystack.Contains(token, StringComparison.Ordinal)));
        }
    }

    private void ClearSearch() => searchText = "";

    private void OnSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
            ClearSearch();
    }

    private void BuildSearchIndex()
    {
        searchIndex = readings.ToDictionary(
            r => r.Id,
            r =>
            {
                var code = r.Department?.MeterCode
                    ?? (meterCodes.TryGetValue(r.DepartmentId, out var known) ? known : "");
                return SearchNormalizer.Normalize($"{r.DepartmentName} {code} {r.CreatedByUserName}");
            });
    }

    private ReadingForm form = new();
    private Months selectedMonth = (Months)DateTime.Today.Month;
    private int selectedYear = DateTime.Today.Year;
    private bool isLoading = true;
    private bool isSaving;
    private bool isExporting;
    private bool isFormOpen;
    private bool showDropdown;

    protected override async Task OnInitializedAsync()
    {
        form.Month = selectedMonth;

        var deps = await Api.GetDepartmentsAsync();
        allActiveDepartments = deps.Where(d => d.IsActive && !d.IsFixed).ToList();
        meterCodes = deps.ToDictionary(d => d.Id, d => d.MeterCode);

        await LoadReadings();
    }

    private void OpenCreate()
    {
        form = new ReadingForm { Month = selectedMonth };
        showDropdown = false;
        isFormOpen = true;
    }

    private void CloseForm() => isFormOpen = false;

    private void FilterDepartments(ChangeEventArgs e)
    {
        form.MeterCode = e.Value?.ToString() ?? "";
        UpdateSearch();
    }

    private void ShowDropdown() => UpdateSearch();

    private async Task HideDropdown()
    {
        // تأخير بسيط للسماح بحدث النقر على النتيجة قبل إخفاء القائمة
        await Task.Delay(150);
        showDropdown = false;
        StateHasChanged();
    }

    private void UpdateSearch()
    {
        departmentResults = string.IsNullOrWhiteSpace(form.MeterCode)
            ? allActiveDepartments.Take(5).ToList()
            : allActiveDepartments
                .Where(d => d.Name.Contains(form.MeterCode, StringComparison.OrdinalIgnoreCase) ||
                            d.MeterCode.Contains(form.MeterCode, StringComparison.OrdinalIgnoreCase))
                .Take(5).ToList();

        showDropdown = departmentResults.Any();
    }

    private void SelectDepartment(DepartmentResponseDto department)
    {
        form.MeterCode = department.MeterCode;
        showDropdown = false;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        isLoading = true;
        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024 * 5);
            await Api.ImportMeterReadingsAsync(stream, selectedMonth, selectedYear);
            Toasts.Success("تم استيراد البيانات بنجاح.");
            await LoadReadings();
        }
        catch (Exception ex)
        {
            Toasts.Error("فشل الاستيراد: " + ex.Message);
        }
        finally { isLoading = false; }
    }

    private async Task ImportCurrentReadings(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        isLoading = true;
        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024 * 5);
            await Api.ImportCurrentReadingsAsync(stream, selectedMonth, selectedYear);
            Toasts.Success("تم استيراد البيانات بنجاح.");
            await LoadReadings();
        }
        catch (Exception ex)
        {
            Toasts.Error("فشل الاستيراد: " + ex.Message);
        }
        finally { isLoading = false; }
    }

    private async Task OnMonthChanged(ChangeEventArgs args)
    {
        if (Enum.TryParse<Months>(args.Value?.ToString(), out var month))
        {
            selectedMonth = month;
            form.Month = month;
            await LoadReadings();
        }
    }

    private async Task OnYearChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var year))
        {
            selectedYear = year;
            await LoadReadings();
        }
    }

    private async Task LoadReadings()
    {
        isLoading = true;
        readings = (await Api.GetMeterReadingsAsync(selectedMonth, selectedYear)).ToList();
        BuildSearchIndex();
        isLoading = false;
    }

    private async Task SaveReading()
    {
        if (string.IsNullOrWhiteSpace(form.MeterCode))
        {
            Toasts.Warning("الرجاء كتابة أو اختيار رمز العداد.");
            return;
        }

        isSaving = true;
        try
        {
            await Api.CreateMeterReadingAsync(new CreateMeterReadingRequestDto(form.MeterCode, form.Month, form.CurrentReading));
            Toasts.Success("تم تسجيل القراءة.");
            selectedMonth = form.Month;

            CloseForm();
            await LoadReadings();
        }
        catch (Exception ex) { Toasts.Error(ex.Message); }
        finally { isSaving = false; }
    }

    private async Task DeleteReading(MeterReadingResponseDto reading)
    {
        if (!await Dialog.ConfirmDeleteAsync($"قراءة {reading.DepartmentName}"))
            return;

        try
        {
            await Api.DeleteMeterReadingAsync(reading.Id);
            Toasts.Success("تم حذف القراءة.");
            await LoadReadings();
        }
        catch (Exception ex) { Toasts.Error(ex.Message); }
    }

    private static string MonthName(Months month) => month switch
    {
        Months.January => "كانون الثاني",
        Months.February => "شباط",
        Months.March => "آذار",
        Months.April => "نيسان",
        Months.May => "أيار",
        Months.June => "حزيران",
        Months.July => "تموز",
        Months.August => "آب",
        Months.September => "أيلول",
        Months.October => "تشرين الأول",
        Months.November => "تشرين الثاني",
        Months.December => "كانون الأول",
        _ => month.ToString()
    };

    private sealed class ReadingForm
    {
        public string MeterCode { get; set; } = string.Empty;
        public Months Month { get; set; }
        public decimal CurrentReading { get; set; }
    }

    private async Task ExportElectricityReport()
    {
        isExporting = true;
        try
        {
            var result = await Api.DownloadElectricityReportAsync(selectedMonth, selectedYear);

            if (!result.IsSuccess)
            {
                Toasts.Warning(result.ErrorMessage ?? "لا يوجد تقرير لهذا الشهر.");
                return;
            }

            var base64 = Convert.ToBase64String(result.Content!);
            await Js.InvokeVoidAsync("downloadFileFromBytes", result.FileName, result.ContentType, base64);

            Toasts.Success("تم تنزيل تقرير الاستهلاك بنجاح.");
        }
        catch (Exception ex)
        {
            Toasts.Error("فشل تنزيل التقرير: " + ex.Message);
        }
        finally { isExporting = false; }
    }
}
