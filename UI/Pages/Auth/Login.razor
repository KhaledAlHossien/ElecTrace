@page "/login"
@layout AuthLayout
@using Application_Contract.DTOs.User
@using UI.Services.Interface
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider

<PageTitle>تسجيل الدخول</PageTitle>

<section class="login-panel">
    <div class="login-copy">
        <span class="brand-mark">ET</span>
        <p class="eyebrow">ElecTrace</p>
        <h1>إدارة فواتير الكهرباء من مكان واحد</h1>
        <p>سجل القراءات، راقب الاستهلاك، وحمّل التقارير الشهرية بسرعة ووضوح.</p>
    </div>

    <div class="login-card">
        <h2>تسجيل الدخول</h2>
        <p>أدخل بيانات حسابك للمتابعة إلى لوحة التحكم.</p>
        <EditForm Model="@formModel" OnValidSubmit="@HandleLogin">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />

            <div class="mb-3">
                <label for="username" class="form-label">اسم المستخدم</label>
                <InputText id="username" class="form-control form-control-lg" @bind-Value="formModel.UserName" />
                <ValidationMessage For="@(() => formModel.UserName)" />
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">كلمة المرور</label>
                <InputText id="password" type="password" class="form-control form-control-lg" @bind-Value="formModel.Password" />
                <ValidationMessage For="@(() => formModel.Password)" />
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            <button type="submit" class="btn btn-primary btn-lg w-100" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm ms-2"></span>
                }
                دخول
            </button>
        </EditForm>
    </div>
</section>

@code {
    private LoginFormModel formModel = new();
    private string errorMessage = string.Empty;
    private bool isLoading = false;

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            var loginDto = new LoginDto(formModel.UserName, formModel.Password);
            var result = await AuthService.LoginAsync(loginDto);

            var customProvider = AuthProvider as CustomAuthStateProvider;
            customProvider?.NotifyUserAuthentication(result.Token);

            Navigation.NavigateTo("/", true);
        }
        catch (UnauthorizedAccessException)
        {
            errorMessage = "اسم المستخدم أو كلمة المرور غير صحيحة.";
        }
        catch (Exception)
        {
            errorMessage = "حدث خطأ أثناء محاولة الدخول. حاول مرة أخرى.";
        }
        finally
        {
            isLoading = false;
        }
    }

    public class LoginFormModel
    {
        public string UserName { get; set; } = "";
        public string Password { get; set; } = "";
    }
}
