@page "/login"
@layout AuthLayout
@using Application_Contract.DTOs.User
@using UI.Services.Interface
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider

<PageTitle>تسجيل الدخول</PageTitle>

<span class="login-orb login-orb-1"></span>
<span class="login-orb login-orb-2"></span>

<section class="login-panel">
    <div class="login-copy">
        <div class="brand-mark-lg">
            <Icon Name="zap" Size="26" />
        </div>
        <p class="eyebrow"><Icon Name="sparkles" Size="13" /> ElecTrace</p>
        <h1>إدارة فواتير الكهرباء من مكان واحد</h1>
        <p>سجل القراءات، راقب الاستهلاك، وحمّل التقارير الشهرية بسرعة ووضوح.</p>

        <div class="login-features">
            <span class="login-feature" style="--i:0"><Icon Name="gauge" Size="15" /> قراءات دقيقة</span>
            <span class="login-feature" style="--i:1"><Icon Name="file-text" Size="15" /> تقارير Excel</span>
            <span class="login-feature" style="--i:2"><Icon Name="shield" Size="15" /> صلاحيات وأدوار</span>
        </div>
    </div>

    <div class="login-card">
        <div class="login-logo">
            <Icon Name="user" Size="24" />
        </div>
        <h2 style="text-align:center;">تسجيل الدخول</h2>
        <p style="text-align:center;">أدخل بيانات حسابك للمتابعة إلى لوحة التحكم.</p>

        <EditForm Model="@formModel" OnValidSubmit="@HandleLogin">
            <DataAnnotationsValidator />

            <div class="login-field" style="--i:0">
                <label class="form-label" for="username">اسم المستخدم</label>
                <div class="input-icon-wrap">
                    <span class="input-icon"><Icon Name="user" Size="17" /></span>
                    <InputText id="username" class="form-control" @bind-Value="formModel.UserName" placeholder="اسم المستخدم" />
                </div>
                <ValidationMessage For="@(() => formModel.UserName)" />
            </div>

            <div class="login-field" style="--i:1">
                <label class="form-label" for="password">كلمة المرور</label>
                <div class="input-icon-wrap">
                    <span class="input-icon"><Icon Name="shield" Size="17" /></span>
                    <InputText id="password" type="password" class="form-control" @bind-Value="formModel.Password" placeholder="••••••••" />
                </div>
                <ValidationMessage For="@(() => formModel.Password)" />
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">
                    <Icon Name="alert-circle" Size="17" />
                    <span>@errorMessage</span>
                </div>
            }

            <button type="submit" class="btn btn-primary login-submit" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner"></span>
                    <span>جاري التحقق...</span>
                }
                else
                {
                    <Icon Name="log-out" Size="18" />
                    <span>دخول</span>
                }
            </button>
        </EditForm>
    </div>
</section>

@code {
    private LoginFormModel formModel = new();
    private string errorMessage = string.Empty;
    private bool isLoading = false;

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            var loginDto = new LoginDto(formModel.UserName, formModel.Password);
            var result = await AuthService.LoginAsync(loginDto);

            var customProvider = AuthProvider as CustomAuthStateProvider;
            customProvider?.NotifyUserAuthentication(result.Token);

            Navigation.NavigateTo("/", true);
        }
        catch (UnauthorizedAccessException)
        {
            errorMessage = "اسم المستخدم أو كلمة المرور غير صحيحة.";
        }
        catch (Exception)
        {
            errorMessage = "حدث خطأ أثناء محاولة الدخول. حاول مرة أخرى.";
        }
        finally
        {
            isLoading = false;
        }
    }

    public class LoginFormModel
    {
        public string UserName { get; set; } = "";
        public string Password { get; set; } = "";
    }
}
