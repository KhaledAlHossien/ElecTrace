@page "/departments"
@attribute [Authorize]
@inject IApiDataService Api
@inject IJSRuntime JS

<PageTitle>الأقسام والعدادات</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">إدارة العدادات</p>
        <h1>الأقسام والعدادات</h1>
        <p>تعريف الأقسام، رقم العداد، معامل التحويل، الحد الأعلى للعداد، ومبلغ الخصم الثابت.</p>
    </div>
</section>

<section class="content-grid two-columns">
    <div class="panel">
        <div class="panel-header">
            <div>
                <h2>@(editingId is null ? "إضافة قسم" : "تعديل قسم")</h2>
                <p>الحقول هنا تُستخدم بحساب الاستهلاك لاحقاً.</p>
            </div>
        </div>

        <EditForm Model="@form" OnValidSubmit="SaveDepartment">
            <DataAnnotationsValidator />
            <div class="form-stack">
                <div>
                    <label class="form-label">اسم القسم</label>
                    <InputText class="form-control" @bind-Value="form.Name" />
                </div>
                <div>
                    <label class="form-label">رمز العداد</label>
                    <InputText class="form-control" @bind-Value="form.MeterCode" />
                </div>
                <div class="form-row">
                    <div>
                        <label class="form-label">معامل التحويل</label>
                        <InputNumber class="form-control" @bind-Value="form.ConversionFactor" />
                    </div>
                </div>
                <div>
                    <label class="form-label">قيمة الخصم (مبلغ ثابت)</label>
                    <InputNumber class="form-control" @bind-Value="form.DiscountAmount" placeholder="0" />
                    <div class="field-hint">ادخل قيمة الخصم كمبلغ مالي مباشر (مثال: 5000). اتركها 0 للافتراضي.</div>
                </div>
                <div class="form-check">
                    <InputCheckbox class="form-check-input" @bind-Value="form.IsActive" />
                    <label class="form-check-label">نشطة</label>
                </div>
                <div class="form-check">
                    <InputCheckbox class="form-check-input" @bind-Value="form.IsFixed" />
                    <label class="form-check-label">ثابت</label>
                </div>
                <div>
                    <label class="form-label">القيمة الثابتة</label>
                    <InputNumber class="form-control" @bind-Value="form.FixedValue" placeholder="0" />
                    <div class="field-hint">ادخل القيمة كمبلغ مالي مباشر (مثال: 5000). اتركها 0 للافتراضي.</div>
                </div>

                @if (!string.IsNullOrWhiteSpace(message))
                {
                    <div class="alert @messageCss">@message</div>
                }
                <div class="button-row">
                    <button class="btn btn-primary" type="submit" disabled="@isSaving">حفظ</button>
                    <button class="btn btn-light" type="button" @onclick="ResetForm">تفريغ</button>
                </div>
            </div>
        </EditForm>
    </div>

    <div class="panel wide-panel">
        <div class="panel-header">
            <div>
                <h2>قائمة الأقسام</h2>
                <p>@departments.Count قسم مسجل.</p>
            </div>
            <div style="display: flex; gap: 0.5rem;">
                <button class="btn btn-success" @onclick="ExportToExcel" disabled="@isExporting">
                    @(isExporting ? "جاري التصدير..." : "📊تصدير")
                </button>
            </div>
            <div class="filters">
                <label class="btn btn-outline-primary" for="fileInput" style="cursor: pointer; margin-left: 10px;">استيراد</label>
                <InputFile id="fileInput" OnChange="HandleFileSelected" hidden />
            </div>

            <input class="form-control search-input" placeholder="بحث..." @bind="searchText" @bind:event="oninput" />

        </div>

        @if (isLoading)
        {
            <div class="loading-panel">جاري تحميل الأقسام...</div>
        }
        else if (!FilteredDepartments.Any())
        {
            <EmptyState Text="لا توجد أقسام مطابقة للبحث." />
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>القسم</th>
                            <th>رمز العداد</th>
                            <th>معامل التحويل</th>
                            <th>الخصم</th>
                            <th>الحالة</th>
                            <th>ثابت؟</th>
                            <th>القيمة الثابتة</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var department in FilteredDepartments)
                        {
                            <tr>
                                <td><strong>@department.Name</strong></td>
                                <td>@department.MeterCode</td>
                                <td>@department.ConversionFactor</td>
                                <td>@department.Discount.ToString("N0") ل.س</td>
                                <td>@(department.IsActive ? "نشط" : "غير نشط")</td>
                                <td>@(department.IsFixed ? "نعم" : "لا")</td>
                                <td>@department.FixedValue.ToString("N0") ل.س</td>
                                <td class="table-actions">
                                    <button class="btn btn-outline-primary btn-sm" @onclick="() => EditDepartment(department)">تعديل</button>
                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteDepartment(department.Id)">حذف</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

@code {
    private List<DepartmentResponseDto> departments = [];
    private DepartmentForm form = new();
    private int? editingId;
    private bool isLoading = true;
    private bool isSaving;
    private bool isExporting;
    private string searchText = "";
    private string message = "";
    private string messageCss = "alert-success";

    private IEnumerable<DepartmentResponseDto> FilteredDepartments =>
        string.IsNullOrWhiteSpace(searchText)
            ? departments
            : departments.Where(x => x.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                || x.MeterCode.Contains(searchText, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadDepartments();
    }

    private async Task LoadDepartments()
    {
        isLoading = true;
        departments = await Api.GetDepartmentsAsync();
        isLoading = false;
    }

    private async Task SaveDepartment()
    {
        isSaving = true;
        message = "";

        try
        {
            if (editingId is int id)
            {
                // ⚠️ تمرير مبلغ الخصم الثابت هنا
                await Api.UpdateDepartmentAsync(id, new UpdateDepartmentRequestDto(form.Name, form.ConversionFactor, form.MeterCode, form.DiscountAmount, form.IsActive, form.IsFixed, form.FixedValue));
                ShowSuccess("تم تعديل القسم بنجاح.");
            }
            else
            {
                // ⚠️ تمرير مبلغ الخصم الثابت هنا
                await Api.CreateDepartmentAsync(new CreateDepartmentRequestDto(form.Name, form.ConversionFactor, form.MeterCode, form.DiscountAmount, form.IsActive, form.IsFixed, form.FixedValue));
                ShowSuccess("تمت إضافة القسم بنجاح.");
            }

            ResetForm();
            await LoadDepartments();
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void EditDepartment(DepartmentResponseDto department)
    {
        editingId = department.Id;
        form = new DepartmentForm
        {
            Name = department.Name,
            MeterCode = department.MeterCode,
            ConversionFactor = department.ConversionFactor,
            DiscountAmount = department.Discount,
            IsActive = department.IsActive,
            IsFixed = department.IsFixed,
            FixedValue = department.FixedValue
        };
    }

    private async Task DeleteDepartment(int id)
    {
        try
        {
            await Api.DeleteDepartmentAsync(id);
            ShowSuccess("تم حذف القسم.");
            await LoadDepartments();
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
    }

    private async Task ExportToExcel()
    {
        try
        {
            isExporting = true;
            var (content, fileName) = await Api.ExportMeterCodesToExcelAsync();
            using var streamRef = new DotNetStreamReference(new MemoryStream(content));
            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
            ShowSuccess("تم تصدير التقرير بنجاح.");
        }
        catch (Exception ex)
        {
            ShowError("فشل تصدير التقرير: " + ex.Message);
        }
        finally
        {
            isExporting = false;
        }
    }

    private void ResetForm()
    {
        editingId = null;
        form = new DepartmentForm();
    }

    private void ShowSuccess(string text)
    {
        message = text;
        messageCss = "alert-success";
    }

    private void ShowError(string text)
    {
        message = text;
        messageCss = "alert-danger";
    }

    private sealed class DepartmentForm
    {
        public string Name { get; set; } = "";
        public string MeterCode { get; set; } = "";
        public decimal ConversionFactor { get; set; } = 1;
        public decimal DiscountAmount { get; set; } = 0;
        public bool IsActive { get; set; } = true;
        public bool IsFixed { get; set; }
        public decimal FixedValue { get; set; } = 0;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        isLoading = true;
        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024 * 5);
            await Api.ImportDepartmentsAsync(stream);
            ShowSuccess("تم استيراد البيانات بنجاح.");
            await LoadDepartments();
        }
        catch (Exception ex)
        {
            ShowError("فشل الاستيراد: " + ex.Message);
        }
        finally { isLoading = false; }
    }
}