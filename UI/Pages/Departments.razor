@page "/departments"
@attribute [Authorize]
@inject IApiDataService Api
@inject IJSRuntime JS
@inject ToastService Toasts
@inject DialogService Dialog

<PageTitle>الأقسام والعدادات</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow"><Icon Name="building" Size="13" /> إدارة العدادات</p>
        <h1>الأقسام والعدادات</h1>
        <p>تعريف الأقسام، رقم العداد، معامل التحويل، ومبلغ الخصم الثابت.</p>
    </div>
    <button class="btn btn-primary" @onclick="OpenCreate">
        <Icon Name="plus" Size="17" />
        <span>إضافة قسم</span>
    </button>
</section>

<section class="panel">
    <div class="panel-header filter-header">
        <div>
            <h2>قائمة الأقسام</h2>
            <p>@FilteredDepartments.Count() من أصل @departments.Count قسم.</p>
        </div>
        <div class="filters">
            <div class="search-wrap">
                <span class="search-icon"><Icon Name="search" Size="16" /></span>
                <input class="form-control search-input" placeholder="بحث بالاسم أو رمز العداد..."
                       @bind="searchText" @bind:event="oninput" />
            </div>

            <label class="btn btn-light" for="fileInput" title="A: اسم القسم — B: عامل الضرب">
                <Icon Name="upload" Size="16" />
                <span>استيراد</span>
            </label>
            <InputFile id="fileInput" OnChange="HandleFileSelected" hidden />

            <button class="btn btn-light" @onclick="ExportToExcel" disabled="@isExporting">
                @if (isExporting)
                {
                    <span class="spinner"></span>
                }
                else
                {
                    <Icon Name="download" Size="16" />
                }
                <span>تصدير</span>
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <TableSkeleton Rows="8" Columns="7" />
    }
    else if (!FilteredDepartments.Any())
    {
        <EmptyState Title="لا توجد أقسام"
                    Text="@(string.IsNullOrWhiteSpace(searchText) ? "ابدأ بإضافة أول قسم للنظام." : "لا توجد أقسام مطابقة للبحث.")"
                    IconName="building">
            @if (string.IsNullOrWhiteSpace(searchText))
            {
                <button class="btn btn-primary btn-sm" @onclick="OpenCreate">
                    <Icon Name="plus" Size="15" />
                    <span>إضافة قسم</span>
                </button>
            }
        </EmptyState>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>القسم</th>
                        <th>رمز العداد</th>
                        <th>معامل التحويل</th>
                        <th>الخصم</th>
                        <th>الحالة</th>
                        <th>ثابت؟</th>
                        <th>القيمة الثابتة</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var index = 0;
                    }
                    @foreach (var department in FilteredDepartments)
                    {
                        <tr style="--i:@(index++ % 25)" @key="department.Id">
                            <td><strong>@department.Name</strong></td>
                            <td><span class="status-pill neutral">@department.MeterCode</span></td>
                            <td>@department.ConversionFactor</td>
                            <td>@department.Discount.ToString("N0") ل.س</td>
                            <td>
                                <span class="status-pill @(department.IsActive ? "success" : "danger")">
                                    <span class="dot"></span>
                                    @(department.IsActive ? "نشط" : "متوقف")
                                </span>
                            </td>
                            <td>@(department.IsFixed ? "نعم" : "لا")</td>
                            <td>@department.FixedValue.ToString("N0") ل.س</td>
                            <td>
                                <div class="table-actions">
                                    <button class="btn btn-light" title="تعديل" @onclick="() => OpenEdit(department)">
                                        <Icon Name="edit" Size="15" />
                                    </button>
                                    <button class="btn btn-outline-danger" title="حذف" @onclick="() => DeleteDepartment(department)">
                                        <Icon Name="trash" Size="15" />
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<Modal IsOpen="@isFormOpen" OnClose="CloseForm"
       Title="@(editingId is null ? "إضافة قسم جديد" : "تعديل القسم")"
       Subtitle="الحقول هنا تُستخدم بحساب الاستهلاك والفواتير."
       IconName="@(editingId is null ? "plus" : "edit")">
    <EditForm Model="@form" OnValidSubmit="SaveDepartment">
        <DataAnnotationsValidator />
        <div class="form-stack">
            <div>
                <label class="form-label">اسم القسم</label>
                <InputText class="form-control" @bind-Value="form.Name" placeholder="مثال: محل رقم 12" />
            </div>

            <div class="form-row">
                <div>
                    <label class="form-label">معامل التحويل</label>
                    <InputNumber class="form-control" @bind-Value="form.ConversionFactor" />
                </div>
                <div>
                    <label class="form-label">قيمة الخصم (مبلغ ثابت)</label>
                    <InputNumber class="form-control" @bind-Value="form.DiscountAmount" placeholder="0" />
                </div>
            </div>
            <div class="field-hint">قيمة الخصم مبلغ مالي مباشر (مثال: 5000). اتركها 0 للافتراضي.</div>

            <div>
                <label class="form-label">حالة القسم</label>
                <div class="switch-row">
                    <label class="switch-item">
                        <InputCheckbox class="form-check-input" @bind-Value="form.IsActive" />
                        <span>نشط</span>
                    </label>
                    <label class="switch-item">
                        <InputCheckbox class="form-check-input" @bind-Value="form.IsFixed" />
                        <span>اشتراك ثابت</span>
                    </label>
                </div>
            </div>

            @if (form.IsFixed)
            {
                <div>
                    <label class="form-label">القيمة الثابتة</label>
                    <InputNumber class="form-control" @bind-Value="form.FixedValue" placeholder="0" />
                    <div class="field-hint">تُحتسب كمبلغ شهري ثابت بدل احتساب الاستهلاك.</div>
                </div>
            }

            <div class="button-row">
                <button class="btn btn-primary" type="submit" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner"></span>
                    }
                    else
                    {
                        <Icon Name="save" Size="17" />
                    }
                    <span>@(editingId is null ? "إضافة القسم" : "حفظ التعديلات")</span>
                </button>
                <button class="btn btn-light" type="button" @onclick="CloseForm">إلغاء</button>
            </div>
        </div>
    </EditForm>
</Modal>

@code {
    private List<DepartmentResponseDto> departments = [];
    private DepartmentForm form = new();
    private int? editingId;
    private bool isLoading = true;
    private bool isSaving;
    private bool isExporting;
    private bool isFormOpen;
    private string searchText = "";

    private IEnumerable<DepartmentResponseDto> FilteredDepartments =>
        string.IsNullOrWhiteSpace(searchText)
            ? departments
            : departments.Where(x => x.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                || x.MeterCode.Contains(searchText, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadDepartments();
    }

    private async Task LoadDepartments()
    {
        isLoading = true;
        departments = await Api.GetDepartmentsAsync();
        isLoading = false;
    }

    private void OpenCreate()
    {
        editingId = null;
        form = new DepartmentForm();
        isFormOpen = true;
    }

    private void OpenEdit(DepartmentResponseDto department)
    {
        editingId = department.Id;
        form = new DepartmentForm
        {
            Name = department.Name,
            MeterCode = department.MeterCode,
            ConversionFactor = department.ConversionFactor,
            DiscountAmount = department.Discount,
            IsActive = department.IsActive,
            IsFixed = department.IsFixed,
            FixedValue = department.FixedValue
        };
        isFormOpen = true;
    }

    private void CloseForm() => isFormOpen = false;

    private async Task SaveDepartment()
    {
        isSaving = true;

        try
        {
            if (editingId is int id)
            {
                await Api.UpdateDepartmentAsync(id, new UpdateDepartmentRequestDto(form.Name, form.ConversionFactor, form.MeterCode, form.DiscountAmount, form.IsActive, form.IsFixed, form.FixedValue));
                Toasts.Success("تم تعديل القسم بنجاح.");
            }
            else
            {
                await Api.CreateDepartmentAsync(new CreateDepartmentRequestDto(form.Name, form.ConversionFactor, form.MeterCode, form.DiscountAmount, form.IsActive, form.IsFixed, form.FixedValue));
                Toasts.Success("تمت إضافة القسم بنجاح.");
            }

            CloseForm();
            await LoadDepartments();
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteDepartment(DepartmentResponseDto department)
    {
        if (!await Dialog.ConfirmDeleteAsync(department.Name))
            return;

        try
        {
            await Api.DeleteDepartmentAsync(department.Id);
            Toasts.Success("تم حذف القسم.");
            await LoadDepartments();
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message);
        }
    }

    private async Task ExportToExcel()
    {
        try
        {
            isExporting = true;
            var (content, fileName) = await Api.ExportMeterCodesToExcelAsync();
            using var streamRef = new DotNetStreamReference(new MemoryStream(content));
            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
            Toasts.Success("تم تصدير الملف بنجاح.");
        }
        catch (Exception ex)
        {
            Toasts.Error("فشل تصدير الملف: " + ex.Message);
        }
        finally
        {
            isExporting = false;
        }
    }

    private sealed class DepartmentForm
    {
        public string Name { get; set; } = "";
        public string MeterCode { get; set; } = "";
        public decimal ConversionFactor { get; set; } = 1;
        public decimal DiscountAmount { get; set; } = 0;
        public bool IsActive { get; set; } = true;
        public bool IsFixed { get; set; }
        public decimal FixedValue { get; set; } = 0;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        isLoading = true;
        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024 * 5);
            await Api.ImportDepartmentsAsync(stream);
            Toasts.Success("تم استيراد البيانات بنجاح.");
            await LoadDepartments();
        }
        catch (Exception ex)
        {
            Toasts.Error("فشل الاستيراد: " + ex.Message);
        }
        finally { isLoading = false; }
    }
}
