@page "/reports"
@attribute [Authorize]
@using Application_Contract.DTOs.Pattern
@inject IApiDataService Api
@inject IJSRuntime Js

<PageTitle>التقارير</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">Excel</p>
        <h1>تقارير النظام</h1>
        <p>تنزيل تقارير الاستهلاك الشهري للكهرباء وتقارير الحركة اليومية.</p>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @messageCss mb-3">@message</div>
}

<section class="panel reports-panel mb-4">
    <div class="panel-header filter-header">
        <div>
            <h2>تقارير الكهرباء</h2>
            <p>إذا لم تكن هناك قراءات، ستظهر رسالة واضحة بدون فتح صفحة خطأ.</p>
        </div>
        <div class="filters">
            <select class="form-select" @bind="selectedMonth">
                @foreach (var month in Enum.GetValues<Months>())
                {
                    <option value="@month">@MonthName(month)</option>
                }
            </select>
            <input class="form-control year-input" type="number" @bind="selectedYear" />
        </div>
    </div>

    <div class="report-actions">
        <button class="report-card report-button" type="button" @onclick="DownloadElectricityReport" disabled="@isDownloading">
            <span>تقرير الاستهلاك</span>
            <strong>Electricity Report</strong>
            <small>قراءات، استهلاك، وقيم الفواتير للشهر المحدد.</small>
        </button>
        <button class="report-card report-button" type="button" @onclick="DownloadInvoicesReport" disabled="@isDownloading">
            <span>كل الفواتير</span>
            <strong>All Invoices</strong>
            <small>ملف جاهز للطباعة والمراجعة لكل الأقسام.</small>
        </button>
    </div>
</section>

<section class="panel reports-panel">
    <div class="panel-header filter-header">
        <div>
            <h2>تقرير الحركة اليومية (المبيعات)</h2>
            <p>حدد النمط والفترة الزمنية لتصدير الحركة اليومية إلى إكسل.</p>
        </div>
        <div class="filters">
            <select class="form-select" @bind="selectedPattern">
                <option value="">-- اختر النمط --</option>
                @foreach (var pattern in patterns)
                {
                    <option value="@pattern.Id.ToString()">@pattern.Name</option>
                }
            </select>

            <input class="form-control" type="date" @bind="startDate" title="من تاريخ" />
            <input class="form-control" type="date" @bind="endDate" title="إلى تاريخ" />
        </div>
    </div>

    <div class="report-actions">
        <button class="report-card report-button" type="button" @onclick="DownloadEttReport" disabled="@isDownloading">
            <span>تقرير مفصل</span>
            <strong>Daily Movement</strong>
            <small>ملف إكسل مفصل يضم الفواتير والزبائن والمجاميع.</small>
        </button>
    </div>
</section>

@code {
    // === متغيرات تقارير الكهرباء ===
    private Months selectedMonth = (Months)DateTime.Today.Month;
    private int selectedYear = DateTime.Today.Year;

    // === متغيرات تقارير ETT ===
    private List<PatternDto> patterns = new();
    private string selectedPattern = "";
    private DateTime startDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime endDate = DateTime.Today;

    // === متغيرات عامة ===
    private bool isDownloading;
    private string message = "";
    private string messageCss = "alert-info";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            patterns = await Api.GetEttPatternsAsync();
            if (patterns.Any())
            {
                // البحث الذكي عن النمط الذي يحتوي على كلمة "مبيعات"
                var salesPattern = patterns.FirstOrDefault(p => p.Name != null && p.Name.Contains("مبيعات", StringComparison.OrdinalIgnoreCase));

                if (salesPattern != null)
                {
                    selectedPattern = salesPattern.Id.ToString();
                }
                else
                {
                    selectedPattern = patterns.First().Id.ToString(); // الاحتياط في حال عدم وجود الكلمة
                }
            }
        }
        catch (Exception ex)
        {
            string friendlyError = GetFriendlyErrorMessage(ex.Message);
            ShowError("فشل تحميل الأنماط: " + friendlyError);
        }
    }

    private async Task DownloadElectricityReport()
    {
        await DownloadReport(() => Api.DownloadElectricityReportAsync(selectedMonth, selectedYear));
    }

    private async Task DownloadInvoicesReport()
    {
        await DownloadReport(() => Api.DownloadInvoicesReportAsync(selectedMonth, selectedYear));
    }

    private async Task DownloadEttReport()
    {
        if (string.IsNullOrWhiteSpace(selectedPattern))
        {
            ShowInfo("الرجاء اختيار النمط أولاً قبل تنزيل التقرير.");
            return;
        }

        if (startDate > endDate)
        {
            ShowError("تاريخ البداية لا يمكن أن يكون أكبر من تاريخ النهاية.");
            return;
        }

        await DownloadReport(() => Api.DownloadEttReportExcelAsync(selectedPattern, startDate, endDate));
    }

    private async Task DownloadReport(Func<Task<ReportDownloadResult>> request)
    {
        isDownloading = true;
        message = "";

        try
        {
            var result = await request();
            if (!result.IsSuccess)
            {
                ShowInfo(result.ErrorMessage ?? "لا يوجد تقرير لهذه البيانات المطابقة.");
                return;
            }

            var base64 = Convert.ToBase64String(result.Content!);
            await Js.InvokeVoidAsync("downloadFileFromBytes", result.FileName, result.ContentType, base64);
            ShowSuccess("تم تجهيز التقرير وتنزيله بنجاح.");
        }
        catch (Exception ex)
        {
            ShowError(GetFriendlyErrorMessage(ex.Message));
        }
        finally
        {
            isDownloading = false;
        }
    }

    private string GetFriendlyErrorMessage(string errorMessage)
    {
        if (string.IsNullOrWhiteSpace(errorMessage))
            return "حدث خطأ غير معروف.";

        if (errorMessage.Contains("network-related", StringComparison.OrdinalIgnoreCase) ||
            errorMessage.Contains("SQL Server", StringComparison.OrdinalIgnoreCase) ||
            errorMessage.Contains("Error Locating Server", StringComparison.OrdinalIgnoreCase) ||
            errorMessage.Contains("connection", StringComparison.OrdinalIgnoreCase) ||
            errorMessage.Contains("ERR_CONNECTION", StringComparison.OrdinalIgnoreCase))
        {
            return "يوجد خطأ بالاتصال (لا يمكن الوصول للخادم أو قاعدة البيانات).";
        }

        return errorMessage;
    }

    private void ShowSuccess(string text)
    {
        message = text;
        messageCss = "alert-success";
    }

    private void ShowInfo(string text)
    {
        message = text;
        messageCss = "alert-info";
    }

    private void ShowError(string text)
    {
        message = text;
        messageCss = "alert-danger";
    }

    private static string MonthName(Months month) => month switch
    {
        Months.January => "كانون الثاني",
        Months.February => "شباط",
        Months.March => "آذار",
        Months.April => "نيسان",
        Months.May => "أيار",
        Months.June => "حزيران",
        Months.July => "تموز",
        Months.August => "آب",
        Months.September => "أيلول",
        Months.October => "تشرين الأول",
        Months.November => "تشرين الثاني",
        Months.December => "كانون الأول",
        _ => month.ToString()
    };
}