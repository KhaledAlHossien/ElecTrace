@page "/reports"
@attribute [Authorize]
@using Application_Contract.DTOs.Pattern
@inject IApiDataService Api
@inject IJSRuntime Js
@inject ToastService Toasts

<PageTitle>التقارير</PageTitle>

<section class="page-header">
    <div>
        <h1>التقارير</h1>
        <p>حدد الفترة ونزّل التقرير بصيغة Excel.</p>
    </div>
</section>

<section class="rpt-card">
    <header class="rpt-head">
        <div class="rpt-head-text">
            <h2>تقارير الكهرباء</h2>
            <p>مبنية على القراءات المسجلة للفترة المحددة.</p>
        </div>
        <div class="rpt-params">
            <label class="rpt-param">
                <span>الشهر</span>
                <select class="form-select" @bind="selectedMonth">
                    @foreach (var month in Enum.GetValues<Months>())
                    {
                        <option value="@month">@MonthName(month)</option>
                    }
                </select>
            </label>
            <label class="rpt-param rpt-param-sm">
                <span>السنة</span>
                <input class="form-control" type="number" @bind="selectedYear" />
            </label>
        </div>
    </header>

    <ul class="rpt-list">
        <li class="rpt-row" style="--i:0">
            <span class="rpt-icon"><Icon Name="zap" Size="18" /></span>
            <div class="rpt-info">
                <strong>تقرير الاستهلاك</strong>
                <span>القراءات والاستهلاك وقيمة فاتورة كل قسم.</span>
            </div>
            @DownloadMeta("electricity")
            <button class="btn btn-soft rpt-btn" type="button" @onclick="DownloadElectricityReport" disabled="@isDownloading">
                @DownloadLabel("electricity")
            </button>
        </li>

        <li class="rpt-row" style="--i:1">
            <span class="rpt-icon"><Icon Name="file-text" Size="18" /></span>
            <div class="rpt-info">
                <strong>كل الفواتير</strong>
                <span>ملف شامل لكل الأقسام، ويميّز الأقسام غير المقروءة.</span>
            </div>
            @DownloadMeta("invoices")
            <button class="btn btn-soft rpt-btn" type="button" @onclick="DownloadInvoicesReport" disabled="@isDownloading">
                @DownloadLabel("invoices")
            </button>
        </li>
    </ul>
</section>

<section class="rpt-card">
    <header class="rpt-head">
        <div class="rpt-head-text">
            <h2>
                نظام الأمين
                @if (isLoadingPatterns)
                {
                    <span class="rpt-conn"><span class="spinner"></span> جاري الاتصال</span>
                }
                else if (patterns.Any())
                {
                    <span class="rpt-conn is-ok"><span class="dot"></span> متصل</span>
                }
                else
                {
                    <span class="rpt-conn is-off"><span class="dot"></span> غير متصل</span>
                }
            </h2>
            <p>الحركة اليومية حسب النمط والفترة الزمنية.</p>
        </div>
        <div class="rpt-params">
            <label class="rpt-param">
                <span>النمط</span>
                <select class="form-select" @bind="selectedPattern" disabled="@isLoadingPatterns">
                    <option value="">@(isLoadingPatterns ? "جاري التحميل..." : "اختر النمط")</option>
                    @foreach (var pattern in patterns)
                    {
                        <option value="@pattern.Id.ToString()">@pattern.Name</option>
                    }
                </select>
            </label>
            <label class="rpt-param">
                <span>من</span>
                <input class="form-control" type="date" @bind="startDate" />
            </label>
            <label class="rpt-param">
                <span>إلى</span>
                <input class="form-control" type="date" @bind="endDate" />
            </label>
        </div>
    </header>

    <ul class="rpt-list">
        <li class="rpt-row" style="--i:0">
            <span class="rpt-icon"><Icon Name="activity" Size="18" /></span>
            <div class="rpt-info">
                <strong>الحركة اليومية — تفصيلي</strong>
                <span>الفواتير والمواد مع مجموع كل فاتورة وكل زبون.</span>
            </div>
            @DownloadMeta("ett")
            <button class="btn btn-soft rpt-btn" type="button" @onclick="DownloadEttReport" disabled="@(isDownloading || isLoadingPatterns)">
                @DownloadLabel("ett")
            </button>
        </li>
    </ul>
</section>

@code {
    private Months selectedMonth = (Months)DateTime.Today.Month;
    private int selectedYear = DateTime.Today.Year;

    private List<PatternDto> patterns = new();
    private string selectedPattern = "";
    private DateTime startDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime endDate = DateTime.Today;

    private bool isDownloading;
    private bool isLoadingPatterns = true;
    private string busyReport = "";
    private readonly Dictionary<string, DateTime> lastDownloaded = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            patterns = await Api.GetEttPatternsAsync();
            if (patterns.Any())
            {
                // البحث الذكي عن النمط الذي يحتوي على كلمة "مبيعات"
                var salesPattern = patterns.FirstOrDefault(p => p.Name != null && p.Name.Contains("مبيعات", StringComparison.OrdinalIgnoreCase));

                selectedPattern = salesPattern != null
                    ? salesPattern.Id.ToString()
                    : patterns.First().Id.ToString();
            }
        }
        catch (Exception ex)
        {
            Toasts.Error("فشل تحميل الأنماط: " + GetFriendlyErrorMessage(ex.Message));
        }
        finally
        {
            isLoadingPatterns = false;
        }
    }

    private RenderFragment DownloadLabel(string key) => __builder =>
    {
        if (busyReport == key)
        {
            <span class="spinner"></span>
            <span>جاري التجهيز</span>
        }
        else
        {
            <Icon Name="download" Size="16" />
            <span>تنزيل</span>
        }
    };

    // بعد التنزيل منعرض وقت آخر تنزيل بدل شارة الصيغة - تأكيد بصري إنو العملية تمت
    private RenderFragment DownloadMeta(string key) => __builder =>
    {
        if (lastDownloaded.TryGetValue(key, out var at))
        {
            <span class="rpt-meta is-done"><Icon Name="check" Size="13" /> @at.ToString("HH:mm")</span>
        }
        else
        {
            <span class="rpt-meta">XLSX</span>
        }
    };

    private Task DownloadElectricityReport()
        => DownloadReport("electricity", () => Api.DownloadElectricityReportAsync(selectedMonth, selectedYear));

    private Task DownloadInvoicesReport()
        => DownloadReport("invoices", () => Api.DownloadInvoicesReportAsync(selectedMonth, selectedYear));

    private async Task DownloadEttReport()
    {
        if (string.IsNullOrWhiteSpace(selectedPattern))
        {
            Toasts.Warning("الرجاء اختيار النمط أولاً قبل تنزيل التقرير.");
            return;
        }

        if (startDate > endDate)
        {
            Toasts.Error("تاريخ البداية لا يمكن أن يكون أكبر من تاريخ النهاية.");
            return;
        }

        await DownloadReport("ett", () => Api.DownloadEttReportExcelAsync(selectedPattern, startDate, endDate));
    }

    private async Task DownloadReport(string key, Func<Task<ReportDownloadResult>> request)
    {
        isDownloading = true;
        busyReport = key;

        try
        {
            var result = await request();
            if (!result.IsSuccess)
            {
                Toasts.Warning(result.ErrorMessage ?? "لا يوجد تقرير لهذه البيانات المطابقة.");
                return;
            }

            var base64 = Convert.ToBase64String(result.Content!);
            await Js.InvokeVoidAsync("downloadFileFromBytes", result.FileName, result.ContentType, base64);
            lastDownloaded[key] = DateTime.Now;
            Toasts.Success("تم تجهيز التقرير وتنزيله بنجاح.");
        }
        catch (Exception ex)
        {
            Toasts.Error(GetFriendlyErrorMessage(ex.Message));
        }
        finally
        {
            isDownloading = false;
            busyReport = "";
        }
    }

    private string GetFriendlyErrorMessage(string errorMessage)
    {
        if (string.IsNullOrWhiteSpace(errorMessage))
            return "حدث خطأ غير معروف.";

        if (errorMessage.Contains("network-related", StringComparison.OrdinalIgnoreCase) ||
            errorMessage.Contains("SQL Server", StringComparison.OrdinalIgnoreCase) ||
            errorMessage.Contains("Error Locating Server", StringComparison.OrdinalIgnoreCase) ||
            errorMessage.Contains("connection", StringComparison.OrdinalIgnoreCase) ||
            errorMessage.Contains("ERR_CONNECTION", StringComparison.OrdinalIgnoreCase))
        {
            return "يوجد خطأ بالاتصال (لا يمكن الوصول للخادم أو قاعدة البيانات).";
        }

        return errorMessage;
    }

    private static string MonthName(Months month) => month switch
    {
        Months.January => "كانون الثاني",
        Months.February => "شباط",
        Months.March => "آذار",
        Months.April => "نيسان",
        Months.May => "أيار",
        Months.June => "حزيران",
        Months.July => "تموز",
        Months.August => "آب",
        Months.September => "أيلول",
        Months.October => "تشرين الأول",
        Months.November => "تشرين الثاني",
        Months.December => "كانون الأول",
        _ => month.ToString()
    };
}
